generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id            Int       @id @default(autoincrement())
  usuario       String?   @db.VarChar(50)
  contraseña   String?   @db.VarChar(50)
  fechacreacion DateTime? @default(now()) @db.DateTime(0)
  cargo         String?   @db.VarChar(50)

  cursos        cursos[]
  agregados     agregados[]
  preguntas      pregunta[]
  participantes   participante[]
}

model cursos {
  id           Int       @id @default(autoincrement())
  titulo       String?   @db.VarChar(70)
  descripcion  String?   @db.VarChar(100)
  area         String?   @db.VarChar(50)
  duracion     String?   @db.VarChar(50)
  fechaPublica DateTime? @db.DateTime(0)
  fechaCierre  DateTime? @db.DateTime(0)
  certificado  String?   @db.VarChar(50)
  cursoLibre   String?   @db.VarChar(50)
  evaluacion   String?   @db.VarChar(50)
  obligatorio  String?   @db.VarChar(50)
  videoURL      String?
  idUsuario     Int  
  usuario     usuarios @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  agregados    agregados[]
  participantes participante[]
  preguntas pregunta[]

}

model pregunta {
  id          Int           @id @default(autoincrement())
  titulo      String
  idUsuario  Int
  idCurso    Int
  usuario     usuarios  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  curso     cursos  @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  alternativas alternativa[]
}

model alternativa {
  id         Int     @id @default(autoincrement())
  texto      String
  seleccionada Boolean @default(false) 
  idPreguntas     Int
  preguntas       pregunta    @relation(fields: [idPreguntas], references: [id], onDelete: Cascade)
}


model agregados {
  id        Int    @id @default(autoincrement())
  idUsuario Int
  idCurso   Int

  usuario   usuarios @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  curso     cursos   @relation(fields: [idCurso], references: [id], onDelete: Cascade)
}

model participante {
  id        Int    @id @default(autoincrement())
  idUsuario Int     
  idCurso   Int
  usuario   usuarios @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  curso   cursos @relation(fields: [idCurso], references: [id], onDelete: Cascade)
}

