generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id            Int       @id @default(autoincrement())
  usuario       String?   @db.VarChar(50)
  contraseña   String?   @db.VarChar(50)
  fechacreacion DateTime? @default(now()) @db.DateTime(0)
  cargo         String?   @db.VarChar(50)

  cursos        cursos[]
}

model cursos {
  id           Int       @id @default(autoincrement())
  titulo       String?   @db.VarChar(70)
  descripcion  String?   @db.VarChar(100)
  area         String?   @db.VarChar(50)
  duracion     String?   @db.VarChar(50)
  fechaPublica DateTime? @db.DateTime(0)
  fechaCierre  DateTime? @db.DateTime(0)
  certificado  String?   @db.VarChar(50)
  cursoLibre   String?   @db.VarChar(50)
  evaluacion   String?   @db.VarChar(50)
  obligatorio  String?   @db.VarChar(50)
  videoURL      String?
  idUsuario     Int  
  usuario     Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

}

model Evaluacion {
  id          Int             @id @default(autoincrement())
  titulo      String
  idUsuario   Int
  idCurso     Int
  fechaCreacion DateTime      @default(now())
  usuario     Usuario         @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  curso       Curso           @relation(fields: [idCurso], references: [id], onDelete: Cascade)
  alternativas Alternativa[]
  respuestasUsuarios RespuestaUsuario[]
}

model Alternativa {
  id          Int             @id @default(autoincrement())
  idEvaluacion Int
  enunciado   String
  evaluacion  Evaluacion       @relation(fields: [idEvaluacion], references: [id], onDelete: Cascade)
  respuestas  Respuesta[]
  respuestasUsuarios RespuestaUsuario[]
}

model Respuesta {
  id          Int             @id @default(autoincrement())
  idAlternativa Int
  correcta    Boolean         @default(false)
  alternativa Alternativa     @relation(fields: [idAlternativa], references: [id], onDelete: Cascade)
  respuestasUsuarios RespuestaUsuario[]
}

model RespuestaUsuario {
  id          Int             @id @default(autoincrement())
  idUsuario   Int
  idEvaluacion Int
  idAlternativa Int
  idRespuesta Int
  usuario     Usuario         @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  evaluacion  Evaluacion       @relation(fields: [idEvaluacion], references: [id], onDelete: Cascade)
  alternativa Alternativa     @relation(fields: [idAlternativa], references: [id], onDelete: Cascade)
  respuesta   Respuesta       @relation(fields: [idRespuesta], references: [id], onDelete: Cascade)
}
